---
import { getCollection } from 'astro:content';
import { resolveI18n } from '../../../content.config';

interface Props {
  currentLang?: string;
}

const academicStreams = await getCollection('academics');
---

<section class="academics-section" id="academics" aria-labelledby="academics-heading">
  <div class="container">
    <div class="academics-header">
      <span class="section-tag">
        ACADEMIC PROGRAMMES
      </span>
      <h2 id="academics-heading" class="academics-title">
        Curriculum Streams and Course Structure
      </h2>
      <p class="academics-intro">
        Affiliated with the Kerala State Board of Education and Directorate of General Education (DGE).
      </p>
    </div>

    <!-- Structured List Layout (Not identical card spam) -->
    <div class="streams-list">
      {academicStreams.map((item, index) => {
        const title = resolveI18n(item.data.title);
        const desc = resolveI18n(item.data.description);
        return (
          <div class="stream-row">
            <div class="stream-meta-col">
              <span class="stream-number">0{index + 1}</span>
              <span class="stream-level-badge">{item.data.level}</span>
              {item.data.seats && (
                <span class="seats-info">{item.data.seats} Sanctioned Seats</span>
              )}
            </div>

            <div class="stream-body-col">
              <h3 class="stream-name">
                {title.text}
              </h3>
              <p class="stream-desc">{desc.text}</p>

              <div class="subjects-block">
                <span class="subjects-label">
                  Course Combinations & Subjects:
                </span>
                <ul class="subjects-list">
                  {item.data.subjects.map((sub) => {
                    const subText = resolveI18n(sub);
                    return (
                      <li>
                        <span>{subText.text}</span>
                      </li>
                    );
                  })}
                </ul>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .academics-section {
    background-color: var(--color-surface-subtle);
    padding-block: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .academics-header {
    margin-bottom: var(--space-8);
  }

  .section-tag {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: var(--space-2);
  }

  .academics-title {
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    color: var(--color-primary-dark);
    margin-bottom: var(--space-2);
  }

  .academics-intro {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
  }

  /* List Layout with horizontal dividers */
  .streams-list {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border-strong);
    background-color: var(--color-surface);
    border-radius: var(--radius-sm);
  }

  .stream-row {
    display: grid;
    grid-template-columns: 220px 1fr;
    padding: var(--space-6);
    border-bottom: 1px solid var(--color-border);
    gap: var(--space-6);
    align-items: start;
  }

  .stream-row:last-child {
    border-bottom: none;
  }

  .stream-meta-col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .stream-number {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }

  .stream-level-badge {
    display: inline-block;
    padding: 3px 8px;
    background-color: var(--color-primary);
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    border-radius: var(--radius-sm);
    letter-spacing: 0.03em;
  }

  .seats-info {
    font-size: 12.5px;
    color: var(--color-text-muted);
    font-weight: 500;
  }

  .stream-body-col {
    display: flex;
    flex-direction: column;
  }

  .stream-name {
    font-size: 1.25rem;
    color: var(--color-primary-dark);
    margin-bottom: var(--space-2);
  }

  .stream-desc {
    font-size: var(--text-base);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    line-height: var(--leading-relaxed);
  }

  .subjects-block {
    background-color: var(--color-surface-subtle);
    padding: var(--space-4);
    border-radius: var(--radius-sm);
    border-left: 3px solid var(--color-accent);
  }

  .subjects-label {
    font-size: 13px;
    font-weight: 700;
    color: var(--color-primary);
    display: block;
    margin-bottom: var(--space-2);
  }

  .subjects-list {
    list-style-type: square;
    padding-left: var(--space-4);
    font-size: 14.5px;
    color: var(--color-text-secondary);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  @media (max-width: 768px) {
    .stream-row {
      grid-template-columns: 1fr;
      padding: var(--space-4);
      gap: var(--space-3);
    }

    .stream-meta-col {
      flex-direction: row;
      align-items: center;
      gap: var(--space-3);
    }
  }
</style>
