---
import siteConfig from '../../../../school.config.json';
import Figure from './Figure.astro';

interface Props {
  currentLang?: string;
}

const founded = siteConfig.foundedYear;
const yearsOfService = siteConfig.statistics?.serviceYears || `${new Date().getFullYear() - founded} Years of Service`;
const schoolName = siteConfig.schoolName.en;
const city = siteConfig.location.city || siteConfig.location.en;
const subDistrict = siteConfig.location.subDistrict || city;
const management = siteConfig.management || 'Corporate Educational Agency';
const campusSize = siteConfig.statistics?.campusSize || 'spacious campus';

const facts = [
  {
    label: "Year Established",
    value: `${founded} (${yearsOfService})`
  },
  {
    label: "Affiliation & Board",
    value: `${siteConfig.affiliation.board}`
  },
  {
    label: "High School Code",
    value: `${siteConfig.affiliation.schoolCode}`
  },
  {
    label: "Higher Secondary Code",
    value: `${siteConfig.affiliation.higherSecondaryCode}`
  },
  {
    label: "Grades Offered",
    value: `${siteConfig.affiliation.grades}`
  },
  {
    label: "Medium of Instruction",
    value: `${siteConfig.affiliation.medium}`
  },
  {
    label: "Student Body (Approx.)",
    value: `${siteConfig.statistics.studentCount}`
  },
  {
    label: "Teaching & Non-Teaching Staff",
    value: `${siteConfig.statistics.staffCount}`
  }
];

const aboutTagline = siteConfig.about?.tagline || `Providing dependable schooling in ${subDistrict} since ${founded}`;
const leadText = siteConfig.about?.leadText || `${schoolName} was established to provide sound, principled schooling to young men and women in ${city} and neighboring areas. Operating under the ${management}, the school welcomes students of all backgrounds and faiths.`;
const secondaryText = siteConfig.about?.secondaryText || `The ${campusSize} includes separate laboratories for physics, chemistry, biology, and computer applications, a well-stocked general library, and a full-size ground. Extracurricular training includes active student development units.`;
---

<section class="facts-section" id="about" aria-labelledby="about-heading">
  <div class="container">
    <div class="facts-header">
      <span class="section-tag">{siteConfig.about?.sectionTag || "ABOUT OUR SCHOOL"}</span>
      <h2 id="about-heading" class="facts-title">
        {aboutTagline}
      </h2>
    </div>

    <div class="facts-grid">
      <!-- Left: Institutional Narrative + Classroom photo -->
      <div class="facts-narrative">
        <p class="lead-text">
          {leadText}
        </p>

        <p class="secondary-text">
          {secondaryText}
        </p>

        <Figure
          src="/images/classroom.jpg"
          alt={`Classroom session at ${schoolName}`}
          aspectRatio="16/9"
          class="facts-inline-photo"
          caption="Regular classroom instruction at the high school wing."
        />
      </div>

      <!-- Right: Tabular Institutional Records -->
      <div class="facts-table-wrap">
        <div class="table-top-bar">
          <span class="table-bar-title">OFFICIAL INSTITUTIONAL RECORDS</span>
        </div>

        <table class="facts-table" aria-label="Key School Facts">
          <tbody>
            {facts.map((item) => (
              <tr>
                <th scope="row" class="fact-label">{item.label}</th>
                <td class="fact-value">{item.value}</td>
              </tr>
            ))}
          </tbody>
        </table>

        <div class="table-note">
          <strong>Institutional Governance:</strong> Government recognized aided institution governed by the General Education Department, Government of Kerala.
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .facts-section {
    background-color: var(--color-surface-subtle);
    padding-block: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .facts-header {
    margin-bottom: var(--space-6);
  }

  .section-tag {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: var(--space-2);
  }

  .facts-title {
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    color: var(--color-primary-dark);
  }

  .facts-grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .facts-narrative {
    display: flex;
    flex-direction: column;
  }

  .lead-text {
    font-size: var(--text-base);
    color: var(--color-text);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-3);
  }

  .secondary-text {
    font-size: var(--text-base);
    color: var(--color-text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-5);
  }

  .facts-inline-photo {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
  }

  .facts-table-wrap {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .table-top-bar {
    background-color: var(--color-primary);
    color: var(--color-primary-contrast);
    padding: var(--space-3) var(--space-4);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .table-bar-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .facts-table {
    width: 100%;
    border-collapse: collapse;
  }

  .facts-table th, .facts-table td {
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--color-border);
    font-size: 13.5px;
    line-height: 1.4;
  }

  .fact-label {
    width: 42%;
    background-color: #F8FAFC;
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  .fact-value {
    color: var(--color-text);
    font-weight: 500;
  }

  .table-note {
    padding: var(--space-3) var(--space-4);
    font-size: 12.5px;
    color: var(--color-text-muted);
    background-color: var(--color-surface-subtle);
    border-top: 1px solid var(--color-border);
    line-height: 1.4;
  }

  @media (max-width: 900px) {
    .facts-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }

  @media (max-width: 480px) {
    .facts-table th, .facts-table td {
      padding: 9px 10px;
      font-size: 13px;
    }

    .fact-label {
      width: 46%;
    }

    .table-bar-title {
      font-size: 12px;
    }

    .table-note {
      padding: 10px;
      font-size: 12px;
    }
  }
</style>
