---
import { getCollection } from 'astro:content';
import { resolveI18n } from '../../../content.config';
import Figure from './Figure.astro';
import Icon from './Icon.astro';

interface Props {
  currentLang?: string;
}

const allNews = await getCollection('news');
const allEvents = await getCollection('events');

const leadNews = allNews.find(n => n.data.featured) || allNews[0];
const otherNews = allNews.filter(n => n.id !== leadNews?.id).slice(0, 2);

function formatEventDate(dateStr: string) {
  const parts = dateStr.split('-');
  const months = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
  const monthIdx = parseInt(parts[1], 10) - 1;
  return {
    day: parts[2],
    month: months[monthIdx],
    year: parts[0]
  };
}
---

<section class="news-events-section" id="news-events" aria-labelledby="news-events-heading">
  <div class="container">
    <div class="section-title-bar">
      <div>
        <span class="section-tag">
          CAMPUS DISPATCH
        </span>
        <h2 id="news-events-heading" class="section-heading">
          School News and Upcoming Calendar
        </h2>
      </div>
      <a href="#events" class="view-all-link">
        <span>Full Academic Calendar</span>
        <Icon name="chevron-right" size={16} />
      </a>
    </div>

    <div class="news-events-grid">
      <!-- Left Column: Lead News Story + Smaller News -->
      <div class="news-column">
        <h3 class="column-subheading">
          LATEST DEVELOPMENTS
        </h3>

        {leadNews && (() => {
          const title = resolveI18n(leadNews.data.title);
          const excerpt = resolveI18n(leadNews.data.excerpt);
          return (
            <article class="lead-story-card">
              <Figure
                src={leadNews.data.image}
                alt={title.text}
                aspectRatio="16/9"
                class="lead-story-photo"
              />
              <div class="lead-story-body">
                <time datetime={leadNews.data.date} class="story-date">
                  {leadNews.data.date}
                </time>
                <h4 class="lead-story-title">
                  <a href="#news-events" class="story-headline-link">
                    {title.text}
                  </a>
                </h4>
                <p class="lead-story-excerpt">
                  {excerpt.text}
                </p>
              </div>
            </article>
          );
        })()}

        <!-- Smaller News Items -->
        <div class="secondary-news-list">
          {otherNews.map((item) => {
            const title = resolveI18n(item.data.title);
            return (
              <article class="secondary-news-item">
                <time datetime={item.data.date} class="secondary-date">
                  {item.data.date}
                </time>
                <h4 class="secondary-title">
                  <a href="#news-events" class="story-headline-link">
                    {title.text}
                  </a>
                </h4>
              </article>
            );
          })}
        </div>
      </div>

      <!-- Right Column: Events Calendar with Date Blocks -->
      <div class="events-column">
        <h3 class="column-subheading">
          UPCOMING EVENTS
        </h3>

        <div class="events-list" role="list">
          {allEvents.map((evt) => {
            const d = formatEventDate(evt.data.date);
            const title = resolveI18n(evt.data.title);
            const venue = resolveI18n(evt.data.venue);
            return (
              <div class="event-item" role="listitem">
                <div class="event-date-box" aria-hidden="true">
                  <span class="event-day">{d.day}</span>
                  <span class="event-month">{d.month}</span>
                </div>
                <div class="event-details">
                  <h4 class="event-title">
                    {title.text}
                  </h4>
                  <div class="event-meta">
                    <span class="event-meta-item">
                      <Icon name="clock" size={14} />
                      <span>{evt.data.time}</span>
                    </span>
                    <span class="event-meta-item">
                      <Icon name="map-pin" size={14} />
                      <span>{venue.text}</span>
                    </span>
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        <div class="events-office-note">
          <p>
            Parents are requested to consult the school office for any revisions to term examinations.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .news-events-section {
    background-color: var(--color-surface);
    padding-block: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .section-title-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: var(--space-6);
  }

  .section-tag {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--color-primary);
    letter-spacing: 0.06em;
    display: block;
    margin-bottom: var(--space-2);
  }

  .section-heading {
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    color: var(--color-primary-dark);
  }

  .view-all-link {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13.5px;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
    padding-bottom: 4px;
  }

  .view-all-link:hover {
    color: var(--color-primary-light);
    text-decoration: underline;
  }

  .news-events-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  .column-subheading {
    font-size: 13px;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    padding-bottom: var(--space-2);
    border-bottom: 2px solid var(--color-primary);
    margin-bottom: var(--space-4);
  }

  /* Lead story card */
  .lead-story-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--color-surface);
    margin-bottom: var(--space-4);
  }

  .lead-story-body {
    padding: var(--space-4);
  }

  .story-date {
    font-size: 13px;
    color: var(--color-text-muted);
    font-weight: 600;
    display: block;
    margin-bottom: 4px;
  }

  .lead-story-title {
    font-size: 1.125rem;
    line-height: 1.35;
    margin-bottom: var(--space-2);
  }

  .story-headline-link {
    color: var(--color-primary-dark);
    text-decoration: none;
  }

  .story-headline-link:hover {
    text-decoration: underline;
    color: var(--color-primary-light);
  }

  .lead-story-excerpt {
    font-size: 14.5px;
    color: var(--color-text-secondary);
    line-height: var(--leading-normal);
  }

  /* Secondary news */
  .secondary-news-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .secondary-news-item {
    padding: var(--space-3);
    background-color: var(--color-surface-subtle);
    border-left: 3px solid var(--color-primary);
    border-radius: var(--radius-sm);
  }

  .secondary-date {
    font-size: 12.5px;
    color: var(--color-text-muted);
    display: block;
    margin-bottom: 2px;
  }

  .secondary-title {
    font-size: 14px;
    font-weight: 600;
    line-height: 1.35;
  }

  /* Events column with date blocks */
  .events-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .event-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background-color: var(--color-surface);
  }

  .event-date-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 54px;
    min-height: 56px;
    background-color: var(--color-primary-dark);
    color: #FFFFFF;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
    padding: 4px;
  }

  .event-day {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1;
    font-family: var(--font-heading);
  }

  .event-month {
    font-size: 11px;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--color-accent);
    margin-top: 2px;
  }

  .event-details {
    flex: 1;
    min-width: 0;
  }

  .event-title {
    font-size: 14.5px;
    color: var(--color-primary-dark);
    line-height: 1.3;
    margin-bottom: 6px;
  }

  .event-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    font-size: 12.5px;
    color: var(--color-text-secondary);
  }

  .event-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .events-office-note {
    margin-top: var(--space-4);
    padding: var(--space-3);
    background-color: var(--color-surface-subtle);
    border-radius: var(--radius-sm);
    font-size: 12.5px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  @media (max-width: 860px) {
    .news-events-grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .section-title-bar {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }
  }
</style>
