---
import siteConfig from '../../../../school.config.json';
import Icon from './Icon.astro';

interface Props {
  currentLang?: string;
}

const schoolTitle = siteConfig.schoolName.en;
---

<!-- Office Contact & Enquiry Section (Light Institutional Section) -->
<section class="office-contact-section" id="contact" aria-labelledby="office-contact-title">
  <div class="container">
    <div class="office-section-header">
      <span class="office-tag">
        <span class="tag-dot" aria-hidden="true"></span>
        OFFICE DESK & CONTACT
      </span>
      <h2 id="office-contact-title" class="office-title">
        Get in Touch with the Administrative Office
      </h2>
      <p class="office-subtitle">
        For admission enquiries, fee verification, student transfers, and general office queries.
      </p>
    </div>

    <div class="office-layout-grid">
      <!-- Left Column: Campus Information & Location -->
      <div class="campus-info-card">
        <div class="campus-brand">
          <img src="/images/crest.svg" alt="" width="48" height="54" class="campus-crest" />
          <div>
            <h3 class="campus-school-name">{schoolTitle}</h3>
            <p class="campus-motto">
              {siteConfig.motto.en}
            </p>
          </div>
        </div>

        <address class="campus-directory">
          <div class="directory-item">
            <span class="directory-icon"><Icon name="map-pin" size={18} /></span>
            <div>
              <span class="directory-label">Campus Address</span>
              <p class="directory-value">{siteConfig.contact.address}</p>
            </div>
          </div>

          <div class="directory-item">
            <span class="directory-icon"><Icon name="phone" size={18} /></span>
            <div>
              <span class="directory-label">Administrative Desk</span>
              <p class="directory-value">
                <a href={`tel:${siteConfig.contact.phone.replace(/\s+/g, '')}`}>{siteConfig.contact.phone}</a>
              </p>
            </div>
          </div>

          <div class="directory-item">
            <span class="directory-icon"><Icon name="mail" size={18} /></span>
            <div>
              <span class="directory-label">Official Email</span>
              <p class="directory-value">
                <a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a>
              </p>
            </div>
          </div>

          <div class="directory-item">
            <span class="directory-icon"><Icon name="clock" size={18} /></span>
            <div>
              <span class="directory-label">Office Timings</span>
              <p class="directory-value">{siteConfig.contact.officeHours}</p>
            </div>
          </div>
        </address>

        <!-- Clean Campus Map Embed -->
        <div class="map-box">
          <iframe
            src={siteConfig.mapEmbedUrl}
            width="100%"
            height="180"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="School Location Map"
            class="map-frame"
          ></iframe>
          <div class="map-link-row">
            <a
              href={siteConfig.mapExternalUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="map-link-action"
            >
              <Icon name="external-link" size={14} />
              <span>Open Directions in Google Maps</span>
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Clean White Enquiry Form Card -->
      <div class="enquiry-card" id="enquiry">
        <div class="enquiry-card-header">
          <h3 class="enquiry-card-title">
            General Office Enquiry
          </h3>
          <p class="enquiry-card-desc">
            Submit your query below. Our administrative desk will review and get back to you.
          </p>
        </div>

        <form
          name="school-enquiry"
          method="POST"
          action="https://formspree.io/f/sample-demo-endpoint"
          data-netlify="true"
          class="clean-enquiry-form"
        >
          <input type="hidden" name="form-name" value="school-enquiry" />

          <div class="form-field">
            <label for="enquiry-name" class="field-label">
              Parent / Student Name *
            </label>
            <input
              type="text"
              id="enquiry-name"
              name="name"
              required
              class="field-input"
              placeholder="e.g. Thomas Varghese"
            />
          </div>

          <div class="form-row-two">
            <div class="form-field">
              <label for="enquiry-phone" class="field-label">
                Mobile Number *
              </label>
              <input
                type="tel"
                id="enquiry-phone"
                name="phone"
                required
                class="field-input"
                placeholder="+91 94470 00000"
              />
            </div>

            <div class="form-field">
              <label for="enquiry-grade" class="field-label">
                Class / Stream
              </label>
              <select id="enquiry-grade" name="grade" class="field-select">
                <option value="Class 1">Class 1</option>
                <option value="Class 5">Class 5</option>
                <option value="Class 8">Class 8</option>
                <option value="Plus One Science (PCMB)">Plus One Science (PCMB)</option>
                <option value="Plus One Science (PCMC)">Plus One Science (PCMC)</option>
                <option value="Plus One Commerce">Plus One Commerce</option>
                <option value="General Query">General Query</option>
              </select>
            </div>
          </div>

          <div class="form-field">
            <label for="enquiry-message" class="field-label">
              Message / Details *
            </label>
            <textarea
              id="enquiry-message"
              name="message"
              rows="3"
              required
              class="field-textarea"
              placeholder="Briefly state your admission, fee, or transfer query..."
            ></textarea>
          </div>

          <button type="submit" class="btn enquiry-submit-btn">
            Submit Enquiry to Office
          </button>
        </form>
      </div>
    </div>
  </div>
</section>

<!-- Main Institutional Footer -->
<footer class="site-footer" role="contentinfo">
  <div class="container footer-main-container">
    <div class="footer-columns-grid">
      <!-- Col 1: Identity & Legacy -->
      <div class="footer-col-identity">
        <div class="footer-identity-row">
          <img src="/images/crest.svg" alt="" width="40" height="46" class="footer-crest" />
          <div>
            <h4 class="footer-school-title">{schoolTitle}</h4>
            <span class="footer-estd">Estd. {siteConfig.foundedYear} • {siteConfig.location.en}</span>
          </div>
        </div>
        <p class="footer-about-snippet">
          {siteConfig.about?.footerSnippet || `Aided Higher Secondary School under the ${siteConfig.management || 'Corporate Management'}, recognized by the General Education Department, Kerala.`}
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="footer-col-nav">
        <h4 class="footer-heading">Quick Navigation</h4>
        <ul class="footer-nav-list">
          <li><a href="/">Home</a></li>
          <li><a href="#about">About the School</a></li>
          <li><a href="#academics">Academic Programs</a></li>
          <li><a href="#admissions">Admissions {siteConfig.admissions?.academicYear || '2026–27'}</a></li>
          <li><a href="#news">News & Events</a></li>
          <li><a href="#merit">Merit Roll & Toppers</a></li>
        </ul>
      </div>

      <!-- Col 3: Student Portals -->
      <div class="footer-col-nav">
        <h4 class="footer-heading">Institutional Services</h4>
        <ul class="footer-nav-list">
          {siteConfig.quickLinks.map((ql) => (
            <li>
              <a href={ql.url}>{ql.label.en}</a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Affiliation & Office Details -->
      <div class="footer-col-info">
        <h4 class="footer-heading">Board Affiliation</h4>
        <ul class="footer-meta-list">
          <li><strong>Board:</strong> {siteConfig.affiliation.board}</li>
          <li><strong>High School Code:</strong> {siteConfig.affiliation.schoolCode}</li>
          <li><strong>Higher Secondary:</strong> {siteConfig.affiliation.higherSecondaryCode}</li>
          <li><strong>Sub-District:</strong> {siteConfig.affiliation.subDistrict || siteConfig.location.subDistrict}</li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Footer Bottom Strip -->
  <div class="footer-bottom-strip">
    <div class="container footer-bottom-flex">
      <div class="footer-copy-wrap">
        <span>© {new Date().getFullYear()} {schoolTitle}. All rights reserved.</span>
      </div>

      <div class="footer-bottom-links">
        <a href="/theme-demo">Theme Preview (3 Palettes)</a>
        <a href="/admin/">Staff Admin Portal</a>
      </div>
    </div>
  </div>
</footer>

<style>
  /* Pre-Footer Office Contact Section */
  .office-contact-section {
    background-color: var(--color-surface);
    padding-block: var(--space-12);
    border-top: 1px solid var(--color-border);
  }

  .office-section-header {
    margin-bottom: var(--space-8);
  }

  .office-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--color-primary);
    background-color: #EEF4F9;
    padding: 4px 10px;
    border-radius: 4px;
    margin-bottom: var(--space-2);
  }

  .tag-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-accent);
  }

  .office-title {
    color: var(--color-primary);
    font-size: clamp(1.4rem, 2.4vw, 2rem);
    margin-bottom: var(--space-2);
    font-family: var(--font-heading);
    line-height: 1.25;
  }

  .office-subtitle {
    color: var(--color-text-muted);
    font-size: 15.5px;
    max-width: 680px;
  }

  .office-layout-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: var(--space-8);
    align-items: start;
  }

  /* Left: Campus Info Card */
  .campus-info-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: var(--space-6);
    box-shadow: 0 4px 16px rgba(8, 26, 45, 0.04);
  }

  .campus-brand {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding-bottom: var(--space-5);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-5);
  }

  .campus-school-name {
    font-size: 1.125rem;
    color: var(--color-primary);
    font-family: var(--font-heading);
    line-height: 1.25;
  }

  .campus-motto {
    font-size: 13px;
    color: var(--color-accent);
    font-style: italic;
    margin-top: 2px;
  }

  .campus-directory {
    font-style: normal;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .directory-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .directory-icon {
    color: var(--color-primary);
    margin-top: 2px;
    flex-shrink: 0;
  }

  .directory-label {
    display: block;
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 2px;
  }

  .directory-value {
    font-size: 14.5px;
    color: var(--color-text);
    line-height: 1.4;
    margin-bottom: 0;
  }

  .directory-value a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .map-box {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: #F8FAFC;
  }

  .map-frame {
    display: block;
    width: 100%;
  }

  .map-link-row {
    padding: 8px 12px;
    background-color: #FFFFFF;
    border-top: 1px solid var(--color-border);
  }

  .map-link-action {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--color-primary);
    text-decoration: none;
  }

  .map-link-action:hover {
    text-decoration: underline;
  }

  /* Right: Clean Enquiry Form Card */
  .enquiry-card {
    background-color: #FFFFFF;
    border: 1px solid var(--color-border);
    border-top: 4px solid var(--color-primary);
    border-radius: var(--radius-sm);
    padding: var(--space-6) var(--space-8);
    box-shadow: 0 4px 16px rgba(8, 26, 45, 0.04);
  }

  .enquiry-card-header {
    margin-bottom: var(--space-5);
  }

  .enquiry-card-title {
    font-size: 1.25rem;
    color: var(--color-primary);
    font-family: var(--font-heading);
    margin-bottom: 4px;
  }

  .enquiry-card-desc {
    font-size: 13.5px;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .clean-enquiry-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .form-row-two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .field-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text);
  }

  .field-input, .field-select, .field-textarea {
    width: 100%;
    padding: 9px 12px;
    background-color: #FFFFFF;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    color: var(--color-text);
    font-size: 14px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .field-input:focus, .field-select:focus, .field-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(8, 26, 45, 0.1);
  }

  .enquiry-submit-btn {
    margin-top: 4px;
    width: 100%;
    min-height: 46px;
    background-color: var(--color-primary);
    color: #FFFFFF;
    font-weight: 600;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-primary);
    transition: background-color 0.15s ease;
  }

  .enquiry-submit-btn:hover {
    background-color: var(--color-primary-light);
  }

  /* Main Institutional Footer */
  .site-footer {
    background-color: var(--color-primary-dark);
    color: #E2E8F0;
    border-top: 3px solid var(--color-accent);
  }

  .footer-main-container {
    padding-block: var(--space-12);
  }

  .footer-columns-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: var(--space-8);
  }

  .footer-identity-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .footer-school-title {
    font-size: 1.0625rem;
    color: #FFFFFF;
    font-family: var(--font-heading);
    line-height: 1.25;
  }

  .footer-estd {
    display: block;
    font-size: 12px;
    color: var(--color-accent);
    margin-top: 2px;
  }

  .footer-about-snippet {
    font-size: 13.5px;
    color: #94A3B8;
    line-height: 1.55;
    max-width: 340px;
  }

  .footer-heading {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #FFFFFF;
    margin-bottom: var(--space-4);
  }

  .footer-nav-list, .footer-meta-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 13.5px;
  }

  .footer-nav-list a {
    color: #CBD5E1;
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .footer-nav-list a:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  .footer-meta-list li {
    color: #94A3B8;
  }

  .footer-meta-list strong {
    color: #E2E8F0;
  }

  /* Footer Bottom Strip */
  .footer-bottom-strip {
    background-color: #040D18;
    padding-block: var(--space-4);
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 13px;
  }

  .footer-bottom-flex {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .footer-copy-wrap {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    color: #94A3B8;
  }

  .footer-bottom-links {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .footer-bottom-links a {
    color: var(--color-accent);
    text-decoration: none;
    font-size: 12.5px;
  }

  .footer-bottom-links a:hover {
    text-decoration: underline;
  }

  @media (max-width: 960px) {
    .office-layout-grid {
      grid-template-columns: 1fr;
    }

    .footer-columns-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }

    .footer-bottom-flex {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }
  }

  @media (max-width: 600px) {
    .form-row-two {
      grid-template-columns: 1fr;
    }

    .footer-columns-grid {
      grid-template-columns: 1fr;
    }

    .enquiry-card {
      padding: var(--space-5) var(--space-4);
    }

    .field-input, .field-select, .field-textarea {
      font-size: 16px;
    }

    .campus-info-card {
      padding: var(--space-4);
    }
  }
</style>
