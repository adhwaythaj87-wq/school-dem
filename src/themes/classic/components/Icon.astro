)}

{name === 'play' && (
  <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" stroke="none" class={className} aria-hidden={ariaHidden ? "true" : undefined}>
    <polygon points="6 3 20 12 6 21 6 3"/>
  </svg>
)}

{name === 'pause' && (
  <svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 24 24" fill="currentColor" stroke="none" class={className} aria-hidden={ariaHidden ? "true" : undefined}>
    <rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>
  </svg>
)}

