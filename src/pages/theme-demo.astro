---
import BaseLayout from '@theme/layouts/BaseLayout.astro';
import UtilityStrip from '@theme/components/UtilityStrip.astro';
import Header from '@theme/components/Header.astro';
import NoticeTicker from '@theme/components/NoticeTicker.astro';
import Hero from '@theme/components/Hero.astro';
import QuickLinks from '@theme/components/QuickLinks.astro';
import AdmissionsBand from '@theme/components/AdmissionsBand.astro';
import Footer from '@theme/components/Footer.astro';
---

<BaseLayout title="Live Rebranding Demonstration | 3 Institutional Palettes" lang="en">
  <!-- Live Theme Switcher Floating Toolbar for Client Sales Pitch -->
  <div class="demo-toolbar" role="region" aria-label="Theme Customizer Controls">
    <div class="container toolbar-container">
      <div class="toolbar-info">
        <strong class="toolbar-title">Live Rebrand Demonstration</strong>
        <span class="toolbar-subtitle">Switch palette to preview instant client rebrand (10-minute setup)</span>
      </div>

      <div class="palette-buttons" role="group" aria-label="Select Palette Variant">
        <button type="button" class="palette-btn active" data-theme-target="default">
          <span class="swatch swatch-maroon"></span>
          <span>1. Heritage Maroon & Amber (Default)</span>
        </button>

        <button type="button" class="palette-btn" data-theme-target="navy">
          <span class="swatch swatch-navy"></span>
          <span>2. St. Thomas Navy & Brass</span>
        </button>

        <button type="button" class="palette-btn" data-theme-target="forest">
          <span class="swatch swatch-forest"></span>
          <span>3. Malabar Forest & Ochre</span>
        </button>
      </div>

      <a href="/" class="btn btn-outline back-home-btn">← Back to Live Site</a>
    </div>
  </div>

  <div slot="header">
    <UtilityStrip currentLang="en" />
    <Header currentLang="en" />
    <NoticeTicker currentLang="en" />
  </div>

  <!-- Palette Contrast Breakdown Card -->
  <section class="demo-spec-section">
    <div class="container">
      <div class="spec-card">
        <h2 class="spec-title">Client Palette & Contrast Verification (WCAG AA Compliance)</h2>
        <p class="spec-desc">
          Every color pair meets or exceeds the strict 4.5:1 WCAG AA contrast ratio. Gold and accent tones are strictly used as fills, borders, or badges with high-contrast text on top.
        </p>

        <div class="swatches-grid">
          <div class="swatch-card">
            <div class="swatch-sample" style="background-color: var(--color-primary); color: #FFF;">
              <span>--color-primary</span>
              <strong>Navy Primary</strong>
            </div>
            <div class="swatch-details">
              <span>Text on White: <strong>12.4:1 (AAA)</strong></span>
            </div>
          </div>

          <div class="swatch-card">
            <div class="swatch-sample" style="background-color: var(--color-accent); color: var(--color-accent-contrast);">
              <span>--color-accent</span>
              <strong>Gold Accent</strong>
            </div>
            <div class="swatch-details">
              <span>Navy on Gold Fill: <strong>7.1:1 (AAA)</strong></span>
            </div>
          </div>

          <div class="swatch-card">
            <div class="swatch-sample" style="background-color: var(--color-alert); color: #FFF;">
              <span>--color-alert</span>
              <strong>Urgent Red</strong>
            </div>
            <div class="swatch-details">
              <span>White on Red: <strong>5.6:1 (AA)</strong></span>
            </div>
          </div>

          <div class="swatch-card">
            <div class="swatch-sample" style="background-color: var(--color-whatsapp); color: #FFF;">
              <span>--color-whatsapp</span>
              <strong>Office WhatsApp</strong>
            </div>
            <div class="swatch-details">
              <span>White on Dark Green: <strong>4.55:1 (AA)</strong></span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Live rendered components below showing the active theme in real time -->
  <Hero currentLang="en" />
  <QuickLinks currentLang="en" />
  <AdmissionsBand currentLang="en" />

  <Footer slot="footer" currentLang="en" />
</BaseLayout>

<script>
  // Dynamic client-side palette switcher
  const buttons = document.querySelectorAll<HTMLButtonElement>('.palette-btn');
  buttons.forEach(btn => {
    btn.addEventListener('click', () => {
      buttons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      const targetTheme = btn.getAttribute('data-theme-target');
      if (targetTheme === 'default') {
        document.documentElement.removeAttribute('data-theme');
      } else if (targetTheme) {
        document.documentElement.setAttribute('data-theme', targetTheme);
      }
    });
  });
</script>

<style>
  .demo-toolbar {
    background-color: #061524;
    color: #FFFFFF;
    padding: var(--space-3) 0;
    border-bottom: 2px solid var(--color-accent);
    position: sticky;
    top: 0;
    z-index: 999;
    box-shadow: var(--shadow-md);
  }

  .toolbar-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .toolbar-info {
    display: flex;
    flex-direction: column;
  }

  .toolbar-title {
    font-size: 14px;
    color: var(--color-accent);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .toolbar-subtitle {
    font-size: 12.5px;
    color: #94A3B8;
  }

  .palette-buttons {
    display: flex;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .palette-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    background-color: #0E2A47;
    border: 1px solid #234E78;
    color: #FFFFFF;
    font-size: 13px;
    font-weight: 600;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all 0.15s ease;
  }

  .palette-btn:hover {
    background-color: #173E66;
    border-color: var(--color-accent);
  }

  .palette-btn.active {
    background-color: var(--color-accent);
    color: #081A2D;
    border-color: #FFFFFF;
    font-weight: 700;
  }

  .swatch {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    display: inline-block;
    border: 1px solid rgba(255, 255, 255, 0.4);
  }

  .swatch-navy { background-color: #0E2A47; }
  .swatch-maroon { background-color: #541424; }
  .swatch-forest { background-color: #173B2B; }

  .back-home-btn {
    min-height: 36px;
    padding: 4px 12px;
    font-size: 13px;
    color: #FFFFFF;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .back-home-btn:hover {
    background-color: rgba(255, 255, 255, 0.15);
  }

  /* Spec card */
  .demo-spec-section {
    padding-block: var(--space-6);
    background-color: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  .spec-card {
    background-color: var(--color-surface-subtle);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-6);
  }

  .spec-title {
    font-size: 1.25rem;
    color: var(--color-primary-dark);
    margin-bottom: var(--space-2);
  }

  .spec-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .swatches-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-3);
  }

  .swatch-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    overflow: hidden;
    background-color: var(--color-surface);
  }

  .swatch-sample {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 13px;
  }

  .swatch-sample strong {
    font-size: 15px;
  }

  .swatch-details {
    padding: var(--space-2) var(--space-3);
    font-size: 12.5px;
    color: var(--color-text-secondary);
    background-color: var(--color-surface-subtle);
    border-top: 1px solid var(--color-border);
  }
</style>
